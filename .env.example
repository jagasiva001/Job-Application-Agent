# Copy to .env (loaded automatically)
DAILY_CAP=25
MIN_MATCH_SCORE=50          # calibrate with: python eval/evaluate.py your_labels.csv
APP_TIMEZONE=Asia/Kolkata
MATCH_BACKEND=tfidf          # tfidf (no download) | embeddings (needs sentence-transformers)
# Set a password before exposing the app beyond localhost:
# APP_USER=admin
# APP_PASSWORD=choose-a-long-password
# DB_PATH=./job_engine.db
PREFILL_ENABLED=1            # 0 on servers/Docker: pre-fill needs a visible browser on your own computer
OPENAI_API_KEY=               # optional: enables the AI review agent
AGENT_MODEL=gpt-5.5
